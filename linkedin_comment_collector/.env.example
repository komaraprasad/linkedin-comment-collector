# Application Settings
PROJECT_NAME="LeadStream Enterprise"
VERSION="2.0.0"

# Apify Scraper Configuration
APIFY_API_TOKEN="apify_api_your_token_here"
APIFY_ACTOR_ID="harvestapi/linkedin-post-comments"
DEFAULT_PROVIDER="apify"

# Server Port
PORT=8000

# Apify cost controls
# Price per comment on your Apify plan (harvestapi: 0.002 FREE/BRONZE/SILVER, 0.0015 GOLD, 0.001 PLATINUM).
# Each run is hard-capped by Apify at price x requested comments.
APIFY_PRICE_PER_COMMENT_USD=0.002
# Re-scraping a post within this many hours is served from the database at no Apify cost (0 disables).
APIFY_REUSE_HOURS=24
